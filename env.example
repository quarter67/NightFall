# Your public site URL (no trailing slash) — required after deploy
BASE_URL=https://your-domain.com

# LootLabs API token (Profile → API Key in LootLabs panel)
LOOTLABS_API_TOKEN=your_64_char_hex_token_here

# Tier 4 = Maximum Profit | Tier 3 = Profit Maximization
LOOTLABS_TIER_ID=4

# Max ads per session (1-5, higher = more revenue)
LOOTLABS_NUM_TASKS=5

# Theme: 1 Classic | 2 Sims | 3 Minecraft | 4 GTA | 5 Space
LOOTLABS_THEME=4

# How long keys stay valid (hours)
KEY_DURATION_HOURS=24

# Server port (Render/Railway set PORT automatically)
PORT=3000

# Optional admin secret for /api/stats?secret=...
ADMIN_SECRET=change_me_to_something_random
